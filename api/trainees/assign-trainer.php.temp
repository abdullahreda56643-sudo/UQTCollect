<?php
// التأكد من عدم الوصول المباشر للملف
define('BASE_PATH', realpath(dirname(__FILE__) . '/../../../'));

require_once BASE_PATH . '/config.php';
require_once BASE_PATH . '/db/connection.php';
require_once BASE_PATH . '/includes/auth.php';
require_once BASE_PATH . '/models/Trainee.php';
require_once BASE_PATH . '/models/User.php';

header('Content-Type: application/json');

try {
    // التحقق من الصلاحيات
    checkPermission('employee');

    // التحقق من طريقة الطلب
    if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
        throw new Exception('طريقة الطلب غير صحيحة');
    }

    // قراءة البيانات المرسلة
    $data = json_decode(file_get_contents('php://input'), true);
    
    if (!isset($data['trainee_id']) || !isset($data['trainer_id'])) {
        throw new Exception('البيانات المطلوبة غير مكتملة');
    }

    // التحقق من صحة البيانات
    $traineeId = (int)$data['trainee_id'];
    $trainerId = (int)$data['trainer_id'];

    if ($traineeId <= 0 || $trainerId <= 0) {
        throw new Exception('معرفات غير صحيحة');
    }

    // إنشاء اتصال قاعدة البيانات
    $db = (new Database())->getConnection();
    $traineeModel = new Trainee($db);
    $userModel = new User($db);

    // التحقق من وجود المتدرب والمدرب
    $trainee = $traineeModel->get($traineeId);
    $trainer = $userModel->get($trainerId);

    if (!$trainee) {
        throw new Exception('المتدرب غير موجود');
    }
    if (!$trainer || $trainer['role'] !== 'trainer') {
        throw new Exception('المدرب غير موجود');
    }

    // تحديث المتدرب
    $result = $traineeModel->update($traineeId, [
        'assigned_to' => $trainerId,
        'assignment_date' => date('Y-m-d H:i:s'),
        'updated_at' => date('Y-m-d H:i:s'),
        'updated_by' => $_SESSION['user_id'] ?? null
    ]);

    if (!$result) {
        throw new Exception('فشل تحديث بيانات المتدرب');
    }

    // تسجيل العملية في سجل النشاطات
    $stmt = $db->prepare("INSERT INTO activity_log (action, module, record_id, description, user_id) 
                         VALUES (?, ?, ?, ?, ?)");
    
    $stmt->execute([
        'assign_trainer',
        'trainees',
        $traineeId,
        sprintf('تم إسناد المدرب %s للمتدرب %s', $trainer['name'], $trainee['full_name']),
        $_SESSION['user_id'] ?? null
    ]);

    echo json_encode([
        'success' => true,
        'message' => 'تم إسناد المدرب بنجاح'
    ]);

} catch (Exception $e) {
    error_log("Error in assign-trainer.php: " . $e->getMessage());
    http_response_code(500);
    echo json_encode([
        'error' => $e->getMessage()
    ]);
}
?>
